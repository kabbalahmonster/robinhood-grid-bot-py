# ============================================
# Grid Trading Bot - Environment Configuration
# ============================================

# Required: Private key for the trading wallet (with 0x prefix)
PRIVATE_KEY=0x...

# Required: RPC URL for blockchain connection
RPC_URL=https://...

# Optional: Multiple RPC URLs for rotation/failover (comma-separated)
# If set, overrides RPC_URL. If not set, uses RPC_URL as before.
# Free public RPCs for Robinhood Chain:
# RPC_URLS=https://rpc.mainnet.chain.robinhood.com,https://robinhood-rpc.publicnode.com,https://robinhood.api.pocket.network
# Free public RPCs for Base:
# RPC_URLS=https://mainnet.base.org,https://base-rpc.publicnode.com,https://base.api.pocket.network
RPC_URLS=

# Required: Chain ID (4663 for Robinhood, 8453 for Base, 1 for Mainnet)
CHAIN_ID=4663

# Trading Configuration
# ---------------------

# Token to trade (base token address)
TOKEN_ADDRESS=0x...

# Token symbol for logging
TOKEN_SYMBOL=TOKEN

# Optional WETH override; chain default is used when empty
WETH_ADDRESS=

# Grid spacing percentage (default: 5%)
GRID_SPACING_PERCENT=5.0

# Maximum number of grid positions (Robinhood: 20, Mainnet: 10)
MAX_POSITIONS=20

# Maximum simultaneously active positions
MAX_ACTIVE_POSITIONS=6

# Minimum profit percentage required before selling (default: 5%)
MIN_PROFIT_PERCENT=5.0

# Initial buy amount in WETH (for first position)
INITIAL_BUY_AMOUNT=0.01

# Slippage tolerance percentage (default: 2%)
SLIPPAGE_TOLERANCE=2.0

# Bank Configuration
# ------------------

# USDG token address for profit banking
USDG_ADDRESS=0x...
# Optional: comma-separated central-wallet allowlist for `grid_bot.py` treasury sweeps.
# Keep empty to require an exact --confirm-recipient acknowledgement for every sweep.
TREASURY_ALLOWED_RECIPIENTS=

# Percentage of profits to bank to USDG (0-100, default: 20)
BANK_PERCENTAGE=20

# Percentage of sold tokens retained as a moonbag (0 to disable)
MOONBAG_PERCENTAGE=1

# Minimum stablecoin output required for banking
BANK_MIN_AMOUNT=0.2

# Sell once P&L exceeds MIN_PROFIT_PERCENT without waiting for sellMin
FAST_PROFIT=true

# Percentage of trading balance available to the bot
TRADEABLE_BALANCE_PERCENT=100

# Bot Behavior
# ------------

# Poll interval in seconds (default: 6)
POLL_INTERVAL_SECONDS=6

# Enable anti-MEV jitter on quotes (default: true)
ANTI_MEV_JITTER=true

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# State file path for persisting positions
STATE_FILE=./data/positions.json

# Condensed console output and timestamp-free minimal logging
COMPACT_MODE=false
MINIMAL_LOGS=false

# Gridless Trading Mode
# ---------------------
# Enable gridless position-based trading (no fixed grid levels)
USE_GRIDLESS=true

# P&L threshold to trigger new buy (default: -10.0, means buy when top position is -10% or worse)
GRIDLESS_BUY_THRESHOLD=-10.0

# P&L threshold to trigger sell (default: 5.0, means sell at +5% profit)
GRIDLESS_SELL_THRESHOLD=5.0

# Stoploss threshold (default: -25.0, sell immediately if position drops to -25%)
GRIDLESS_STOPLOSS_THRESHOLD=-25.0

# Enable stoploss sells (default: false)
GRIDLESS_STOPLOSS_ENABLED=false

# Leading Edge Mode (default: true)
# When enabled with only 1 position: buy at 50% of sell threshold (e.g., +2.5% if sell=5%)
# This keeps you positioned on the leading edge during run-ups
GRIDLESS_LEADING_EDGE=true

# Minimum seconds between gridless buys (default: 0, disabled)
GRIDLESS_BUY_COOLDOWN_SECONDS=0

# Maximum recovery toward the trigger allowed before executing a buy (0-100%)
GRIDLESS_BUY_EXECUTION_MARGIN=50

# ETH Trading Mode
# ----------------
# Enable native ETH trading instead of WETH (default: true)
# When enabled, bot uses native ETH for buys and receives ETH on sells
# No need to wrap/unwrap ETH manually - 0x API handles it automatically
USE_ETH_TRADING=true

# ETH gas reserve amount (default: 0.001 ETH)
# This amount of ETH is always reserved and never used for trading
# Ensures you always have gas for transactions
ETH_GAS_RESERVE=0.001

# Gas Multipliers
# ----------------
# Multipliers applied to gas limit and gas price estimates
# Lower values = cheaper transactions, higher risk of failure
# Higher values = more expensive transactions, lower risk of failure
# Robinhood Chain: 1.05 is usually sufficient (5% buffer)
# Base/Mainnet: 1.1-1.2 may be needed during congestion
GAS_LIMIT_MULTIPLIER=1.05
GAS_PRICE_MULTIPLIER=1.05

# API Provider Selection
# ----------------------
# Valid values: 0x, lifi, uniswap, sushiswap (lowercase).
# When set, SWAP_PROVIDER takes precedence over the legacy USE_* flags below.
# Leave empty to retain legacy selection: USE_UNISWAP_API=true, then
# USE_LI_FI=true, otherwise 0x.
SWAP_PROVIDER=
# Retryable primary failures (404/429/timeouts/5xx) switch to this provider
# for the rest of the process. Set empty to disable automatic fallback.
SWAP_FALLBACK_PROVIDER=sushiswap

# Sushi v7 aggregator (API key optional; create one at https://sushi.com/portal)
SUSHI_API_KEY=

# Option 1: Uniswap API (recommended for best gas prices)
# Get API key at: https://app.uniswap.org/
USE_UNISWAP_API=true
UNISWAP_API_KEY=your_uniswap_api_key_here
UNISWAP_PERMIT2_DISABLED=true  # Set to true to bypass Permit2

# Option 2: LI.FI (alternative aggregator)
# Get API key at: https://li.fi/
USE_LI_FI=false
LI_FI_API_KEY=your_li_fi_api_key_here
LI_FI_INTEGRATOR=your_integrator_name_here

# Option 3: 0x Protocol (default if others not enabled)
# Get API key at: https://0x.org/
ZEROX_API_KEY=your_0x_api_key_here

# Dashboard Reporting (optional)
# Leave DASHBOARD_URL empty to disable reporting.
DASHBOARD_URL=
DASHBOARD_API_KEY=
# BOT_ID defaults to TOKEN_SYMBOL when empty.
BOT_ID=
DASHBOARD_NAME=
DASHBOARD_GROUP=
