# ============================================
# ROBINHOOD CHAIN CONFIGURATION (Chain ID 4663)
# ============================================
# Copy this file to .env to use Robinhood Chain
# cp .env.robinhood .env

# Required: Private key for the trading wallet
PRIVATE_KEY=your_private_key_here

# RPC URL for Robinhood Chain
# Option 1: Alchemy (paid, reliable)
RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/your_alchemy_key_here
# Option 2: Free public RPCs with rotation/failover (uncomment to use)
# RPC_URLS=https://rpc.mainnet.chain.robinhood.com,https://robinhood-rpc.publicnode.com,https://robinhood.api.pocket.network
RPC_URLS=
# Option 3: Single public RPC (no rotation)
# RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Chain ID for Robinhood
CHAIN_ID=4663

# Dashboard Reporting (optional)
# Leave DASHBOARD_URL empty to disable reporting.
DASHBOARD_URL=
DASHBOARD_API_KEY=
# BOT_ID defaults to TOKEN_SYMBOL when empty.
BOT_ID=
DASHBOARD_NAME=
DASHBOARD_GROUP=

# Token Configuration
# Token to trade (examples: TENDIES, PONS, etc.)
TOKEN_ADDRESS=0x...your_token_address_here...
TOKEN_SYMBOL=YOUR_TOKEN

# USDG (Robinhood USD) for profit banking
USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
# Optional treasury sweep recipient allowlist; leave empty to require one-time confirmation.
TREASURY_ALLOWED_RECIPIENTS=

# WETH on Robinhood
WETH_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73

# Trading Parameters
GRID_SPACING_PERCENT=6.0
MAX_POSITIONS=24
MAX_ACTIVE_POSITIONS=6
MIN_PROFIT_PERCENT=5.0
INITIAL_BUY_AMOUNT=0.001
SLIPPAGE_TOLERANCE=2.0
# Manual fee-on-transfer mode. Use this only when the token's fixed fee is
# already known; manual mode takes precedence over automatic detection.
TAXED_TOKEN=false
TOKEN_TRANSFER_FEE_PERCENT=0
TAXED_TOKEN_SLIPPAGE_BUFFER_PERCENT=2
TAXED_TOKEN_FAILURE_COOLDOWN_SECONDS=300
# Robinhood Chain has many fee-on-transfer tokens. Two consistent bounded
# tax-specific simulation failures may activate runtime protection without
# editing .env. 404/429 responses and unrelated route errors are ignored.
AUTO_DETECT_TOKEN_TRANSFER_FEE=true
AUTO_DETECT_TOKEN_TRANSFER_FEE_MAX_PERCENT=13

# Profit Distribution
BANK_PERCENTAGE=20          # % of profit to swap to USDG (0 to disable)
# Optional: send a percentage of positive measured sell profit to a fee wallet.
# Principal and losing/break-even sells are never charged. BANK_PERCENTAGE plus
# PROFIT_FEE_PERCENT must not exceed 100; attempts are audited locally.
PROFIT_FEE_PERCENT=0
# Required only when PROFIT_FEE_PERCENT > 0; otherwise leave blank.
PROFIT_FEE_WALLET=
# Minimum accumulated settlement asset before sending a profit fee.
MIN_PROFIT_FEE_TRANSFER_ETH=0.0001
MOONBAG_PERCENTAGE=1        # % of tokens to keep after sell (0 to disable)
BANK_MIN_AMOUNT=0.2         # Minimum USDG to receive (skip banking if below)

# Advanced Trading
FAST_PROFIT=true            # Sell when P&L > MIN_PROFIT, even if not at sellMin trigger
TRADEABLE_BALANCE_PERCENT=100  # % of WETH balance available for trading

# Bot Settings
# Robinhood Chain is fast - can poll every 1-5 seconds
POLL_INTERVAL_SECONDS=6
ANTI_MEV_JITTER=true
STARTUP_JITTER_SECONDS=20
# INFO is quiet operational output; DEBUG adds full per-round/quote telemetry.
LOG_LEVEL=INFO
STATE_FILE=./data/positions_robinhood.json

# Compact Output Mode (for tmux multi-pane view)
# Set true for a condensed status block every round. When false, INFO mode
# prints only operational events; LOG_LEVEL=DEBUG enables verbose round output.
COMPACT_MODE=false

# Minimal Logs (remove timestamps from console output)
# Set to true for cleaner output (recommended with COMPACT_MODE)
# Set to false for standard timestamped logs (default)
MINIMAL_LOGS=false

# Print the Mercury trading evocation once at successful bot startup
MERCURY_EVOCATION=true

# Gridless Trading Mode
# ---------------------
# Enable gridless position-based trading (no fixed grid levels)
# Buys when top position P&L drops below threshold, sells at profit target
USE_GRIDLESS=true

# P&L threshold to trigger new buy (default: -10.0)
# Buy when top position is -10% or worse (avg down on dips)
GRIDLESS_BUY_THRESHOLD=-10.0

# P&L threshold to trigger sell (default: 5.0)
# Sell when any position reaches +5% profit
GRIDLESS_SELL_THRESHOLD=5.0

# Stoploss threshold (default: -25.0)
# Sell immediately if position drops to -25% (ignores min profit check)
GRIDLESS_STOPLOSS_THRESHOLD=-25.0

# Enable stoploss sells (default: false)
GRIDLESS_STOPLOSS_ENABLED=false

# Leading Edge Mode (default: true)
# When enabled with only 1 position: buy at 50% of sell threshold (e.g., +2.5% if sell=5%)
# This keeps you positioned on the leading edge during run-ups
GRIDLESS_LEADING_EDGE=true

# Buy Cooldown (default: 0, disabled)
# Minimum time between gridless buys. Prevents rapid-fire buys at same price.
# Cooldown resets after each sell, allowing buy->sell->buy cycles.
GRIDLESS_BUY_COOLDOWN_SECONDS=0

# Buy Execution Margin (default: 50)
# Percentage of threshold distance that price can recover before blocking buy.
# e.g., 50% margin at -10% trigger: block if quote > -5% (-10 + 10*0.5 = -5)
# Bigger drops (-12%, -16%) are always fine. Only blocks price recovery between trigger and execution.
GRIDLESS_BUY_EXECUTION_MARGIN=50

# ETH Trading Mode
# ----------------
# Enable native ETH trading instead of WETH (default: true)
# When enabled, bot uses native ETH for buys and receives ETH on sells
# No need to wrap/unwrap ETH manually - 0x API handles it automatically
USE_ETH_TRADING=true

# ETH gas reserve amount (default: 0.0005 ETH)
# This amount of ETH is always reserved and never used for trading
# Ensures you always have gas for transactions
ETH_GAS_RESERVE=0.0005
# Extra ETH retained per open position by treasury `available` sweeps; 0 disables.
TREASURY_POSITION_RESERVE_ETH=0

# Gas Multipliers
# ----------------
# Multipliers applied to gas limit and gas price estimates
# Lower values = cheaper transactions, higher risk of failure
# Higher values = more expensive transactions, lower risk of failure
# Robinhood Chain: 1.05 is usually sufficient (5% buffer)
GAS_LIMIT_MULTIPLIER=1.05
GAS_PRICE_MULTIPLIER=1.0
GAS_PRICE_FRESHNESS_MULTIPLIER=1.01
MAX_SWAP_GAS_ETH=0.00004
# Optional per-operation overrides. Blank values inherit MAX_SWAP_GAS_ETH.
MAX_BUY_GAS_ETH=
MAX_SELL_GAS_ETH=
MAX_FEE_TRANSFER_GAS_ETH=

# API Provider Selection
# ----------------------
# Valid values: 0x, lifi, uniswap, sushiswap (lowercase).
# When set, SWAP_PROVIDER takes precedence over the legacy USE_* flags below.
# Leave empty to retain legacy selection: USE_UNISWAP_API=true, then
# USE_LI_FI=true, otherwise 0x.
SWAP_PROVIDER=
ROUTE_TOURNAMENT_MODE=off
# Retryable primary failures (404/429/timeouts/5xx) switch to this provider
# immediately for that operation. Each new operation tries the primary first.
# With Sushi primary, this default reverses to Uniswap when its key is set.
# Set empty to disable automatic fallback.
SWAP_FALLBACK_PROVIDER=sushiswap

# Sushi v7 aggregator (API key optional; create one at https://sushi.com/portal)
SUSHI_API_KEY=

# Option 1: Uniswap API (recommended for best gas prices)
# Get API key at: https://app.uniswap.org/
USE_UNISWAP_API=true
UNISWAP_API_KEY=your_uniswap_api_key_here
UNISWAP_PERMIT2_DISABLED=true
UNISWAP_RATE_LIMIT_RPS=4
UNISWAP_COOLDOWN_BASE_SECONDS=30
UNISWAP_COOLDOWN_MAX_SECONDS=900
UNISWAP_RATE_STATE_FILE=

# Option 2: LI.FI (alternative aggregator)
# Get API key at: https://li.fi/
USE_LI_FI=false
LI_FI_API_KEY=your_li_fi_api_key_here
LI_FI_INTEGRATOR=your_integrator_name_here

# Option 3: 0x Protocol (default if others not enabled)
# Get API key at: https://0x.org/
ZEROX_API_KEY=your_0x_api_key_here
