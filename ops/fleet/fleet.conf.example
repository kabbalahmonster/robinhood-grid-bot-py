# Local fleet topology. Copy this file to fleet.conf and edit it.
# fleet.conf is gitignored because each machine's paths and fleet are different.

FLEET_SESSION="bot_farm"
FLEET_WINDOW="fleet"
FLEET_ENTRYPOINT="grid_bot.py"
FLEET_RESTART_DELAY=5
FLEET_START_STAGGER=1
# The guardian is deliberately conservative: snapshots must stay stale across
# three checks before it restarts one bot.  It never restarts the whole fleet.
FLEET_GUARDIAN_INTERVAL=30
FLEET_GUARDIAN_STALE_SECONDS=180
FLEET_GUARDIAN_CONFIRMATIONS=3

# Default dotenv template for initialize-bots. A command-line --template PATH
# overrides this for one run.
FLEET_ENV_TEMPLATE="$HOME/bot-farm/fleet-command/.env.template"

# Optional default used by usdg-sweep and treasury-transfer when --recipient is
# omitted. This is a public address, not a secret. Every bot's .env must still
# include it in TREASURY_ALLOWED_RECIPIENTS (or the command needs an exact
# --confirm-recipient override).
FLEET_TREASURY_RECIPIENT=""

# Fleet checkout layout and authoritative membership. Every name resolves to
# $FLEET_BOT_ROOT/<name>/$FLEET_CHECKOUT_DIRNAME. Add or remove names here so
# every fleet command uses the same deterministic target list and pane order.
FLEET_BOT_ROOT="$HOME/bot-farm/rh-bots"
FLEET_CHECKOUT_DIRNAME="robinhood-grid-bot-py"
FLEET_BOT_NAMES=(
  example-one
  example-two
)

# Legacy fallback: when neither FLEET_BOT_NAMES nor FLEET_BOT_DIRS is set,
# recursively discover checkouts containing FLEET_ENTRYPOINT below the root.
# `fleet-discover` prints a suggested FLEET_BOT_NAMES block for migration.
FLEET_DISCOVERY_MAX_DEPTH=4

# Optional explicit membership override. If this array exists and is non-empty,
# it takes priority over FLEET_BOT_ROOT. Uncomment when exact membership is
# preferable to discovery. Each checkout needs its own .env and data directory.
# FLEET_BOT_DIRS=(
#   "$HOME/bot-farm/rh-bots/example-one/robinhood-grid-bot-py"
#   "$HOME/bot-farm/rh-bots/example-two/robinhood-grid-bot-py"
# )
