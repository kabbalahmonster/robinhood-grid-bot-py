#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
REPO_ROOT="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null)" || {
  printf 'Error: initialize-bots must live inside a Git checkout\n' >&2
  exit 1
}

# shellcheck source=ops/fleet/fleet-common.sh
source "$SCRIPT_DIR/fleet-common.sh"

usage() {
  cat <<'EOF'
Usage:
  initialize-bots [--template PATH] [options] SYMBOL[=ADDRESS]...

Create independent bot checkouts below FLEET_BOT_ROOT. Preview is the default;
add --apply to clone, generate wallets, and create protected .env files.

Token forms:
  NET=0x1234...abcd   Set TOKEN_ADDRESS
  INDEX               Leave TOKEN_ADDRESS blank for later configuration

Options:
  --template PATH      Dotenv template; overrides FLEET_ENV_TEMPLATE
  --config PATH        Fleet config (normal fleet lookup order by default)
  --repo URL           Git source (defaults to this checkout's origin)
  --branch NAME        Clone one branch instead of the remote default
  --python PATH        Python used for secure wallet generation
  --install-deps       Create .venv and install requirements.txt in each clone
  --add-to-fleet       Add the new folder names to FLEET_BOT_NAMES on --apply
  --overwrite-default NAME=VALUE
                       Set/append one .env value in every new bot; repeatable
  --show-private-keys  After success, print a MetaMask import list (sensitive)
  --apply              EXECUTE: create folders/clones/wallets/.env files
                       (without it, validation and preview only; no files change)
  -h, --help           Show this help
EOF
}

display_override() {
  local assignment="$1" name="${1%%=*}" upper_name
  upper_name="${name^^}"
  if [[ "$upper_name" =~ (KEY|SECRET|TOKEN|PASSWORD|MNEMONIC|CREDENTIAL) ]]; then
    printf '%s=<redacted>\n' "$name"
  else
    printf '%s\n' "$assignment"
  fi
}

template=""
config_path=""
repo_url=""
branch=""
python_bin=""
apply=0
install_deps=0
show_private_keys=0
add_to_fleet=0
declare -a specs=() symbols=() folders=() addresses=() final_parents=()
declare -a public_addresses=() private_keys=()
declare -a overrides=()

while (($#)); do
  case "$1" in
    --template) (($# >= 2)) || fleet_die "--template requires a path"; template="$2"; shift 2 ;;
    --config) (($# >= 2)) || fleet_die "--config requires a path"; config_path="$2"; shift 2 ;;
    --repo) (($# >= 2)) || fleet_die "--repo requires a URL or path"; repo_url="$2"; shift 2 ;;
    --branch) (($# >= 2)) || fleet_die "--branch requires a name"; branch="$2"; shift 2 ;;
    --python) (($# >= 2)) || fleet_die "--python requires a path"; python_bin="$2"; shift 2 ;;
    --install-deps) install_deps=1; shift ;;
    --add-to-fleet) add_to_fleet=1; shift ;;
    --overwrite-default)
      (($# >= 2)) || fleet_die "--overwrite-default requires NAME=VALUE"
      overrides+=("$2")
      shift 2
      ;;
    --show-private-keys) show_private_keys=1; shift ;;
    --apply) apply=1; shift ;;
    -h|--help) usage; exit 0 ;;
    --) shift; specs+=("$@"); break ;;
    -*) fleet_die "Unknown option: $1" ;;
    *) specs+=("$1"); shift ;;
  esac
done

((${#specs[@]} > 0)) || fleet_die "Provide at least one SYMBOL or SYMBOL=ADDRESS"

FLEET_CONFIG_PATH="${config_path:-${FLEET_CONFIG:-$(fleet_default_config)}}"
[[ -f "$FLEET_CONFIG_PATH" ]] || fleet_die "Fleet config not found: $FLEET_CONFIG_PATH"
# fleet.conf is trusted local Bash configuration.
# shellcheck disable=SC1090
source "$FLEET_CONFIG_PATH"
config_real="$(readlink -f -- "$FLEET_CONFIG_PATH")"
: "${FLEET_ENV_TEMPLATE:=}"
: "${FLEET_BOT_ROOT:=${HOME}/bot-farm/rh-bots}"
: "${FLEET_CHECKOUT_DIRNAME:=robinhood-grid-bot-py}"
template="${template:-$FLEET_ENV_TEMPLATE}"
[[ -n "$template" ]] || fleet_die "No env template configured; pass --template PATH or set FLEET_ENV_TEMPLATE in fleet.conf"
template="$(readlink -f -- "$template")"
[[ -f "$template" && -r "$template" ]] || fleet_die "Template is not a readable file: $template"
[[ "$FLEET_CHECKOUT_DIRNAME" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || fleet_die "Invalid FLEET_CHECKOUT_DIRNAME"
root_real="$(readlink -m -- "$FLEET_BOT_ROOT")"
home_real="$(readlink -f -- "$HOME")"
[[ "$root_real" != / && "$root_real" != "$home_real" ]] || fleet_die "Refusing dangerously broad FLEET_BOT_ROOT: $root_real"

repo_url="${repo_url:-$(git -C "$REPO_ROOT" remote get-url origin 2>/dev/null || true)}"
[[ -n "$repo_url" ]] || fleet_die "No origin remote found; pass --repo URL"

if [[ -z "$python_bin" ]]; then
  if [[ -x "$REPO_ROOT/.venv/bin/python" ]]; then python_bin="$REPO_ROOT/.venv/bin/python"
  elif [[ -x "$REPO_ROOT/venv/bin/python" ]]; then python_bin="$REPO_ROOT/venv/bin/python"
  else python_bin="$(command -v python3 || true)"
  fi
fi
[[ -x "$python_bin" ]] || fleet_die "Python interpreter is not executable: $python_bin"

declare -A seen_overrides=()
for override in "${overrides[@]}"; do
  [[ "$override" == *=* ]] || fleet_die "Override must be NAME=VALUE: $override"
  override_name="${override%%=*}"
  override_value="${override#*=}"
  [[ "$override_name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || fleet_die "Invalid override variable name: $override_name"
  case "$override_name" in
    PRIVATE_KEY|TOKEN_SYMBOL|TOKEN_ADDRESS) fleet_die "$override_name is managed by initialize-bots and cannot be overridden" ;;
  esac
  [[ "$override_value" != *$'\n'* && "$override_value" != *$'\r'* ]] || fleet_die "Override for $override_name contains a newline"
  [[ -z "${seen_overrides[$override_name]+x}" ]] || fleet_die "Duplicate override variable: $override_name"
  seen_overrides["$override_name"]=1
done

declare -A seen=()
for spec in "${specs[@]}"; do
  raw_symbol="${spec%%=*}"
  address=""
  [[ "$spec" != *=* ]] || address="${spec#*=}"
  [[ "$raw_symbol" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] || fleet_die "Invalid symbol '$raw_symbol'; use letters, digits, underscore, or hyphen"
  symbol="${raw_symbol^^}"
  folder="${raw_symbol,,}"
  [[ -z "$address" || "$address" =~ ^0x[0-9a-fA-F]{40}$ ]] || fleet_die "Invalid address for $symbol: $address"
  [[ -z "${seen[$folder]+x}" ]] || fleet_die "Duplicate token resolves to folder '$folder'"
  seen["$folder"]=1
  final_parent="$root_real/$folder"
  [[ ! -e "$final_parent" ]] || fleet_die "Destination already exists: $final_parent"
  symbols+=("$symbol")
  folders+=("$folder")
  addresses+=("$address")
  final_parents+=("$final_parent")
done

if ((add_to_fleet)); then
  if declare -p FLEET_BOT_DIRS >/dev/null 2>&1 && ((${#FLEET_BOT_DIRS[@]} > 0)); then
    fleet_die "--add-to-fleet requires FLEET_BOT_NAMES membership; FLEET_BOT_DIRS is configured"
  fi
  declare -A configured_names=()
  if declare -p FLEET_BOT_NAMES >/dev/null 2>&1; then
    for configured_name in "${FLEET_BOT_NAMES[@]}"; do
      configured_names["$configured_name"]=1
    done
  fi
  for folder in "${folders[@]}"; do
    [[ -z "${configured_names[$folder]+x}" ]] || fleet_die "Bot name already exists in FLEET_BOT_NAMES: $folder"
  done
fi

printf 'New bot plan (%d):\n' "${#symbols[@]}"
printf '  Root:     %s\n  Checkout: %s\n  Template: %s\n  Repository: %s\n' "$root_real" "$FLEET_CHECKOUT_DIRNAME" "$template" "$repo_url"
if ((add_to_fleet)); then
  printf '  Fleet config: add %s to FLEET_BOT_NAMES in %s\n' "${folders[*]}" "$config_real"
fi
if ((${#overrides[@]})); then
  printf '  Shared .env overrides:\n'
  for override in "${overrides[@]}"; do
    printf '    '
    display_override "$override"
  done
fi
for index in "${!symbols[@]}"; do
  shown_address="${addresses[$index]:-(blank; configure before starting)}"
  printf '  %-12s -> %s/%s  TOKEN_ADDRESS=%s\n' "${symbols[$index]}" "${final_parents[$index]}" "$FLEET_CHECKOUT_DIRNAME" "$shown_address"
done
if ((apply == 0)); then
  printf '\nPreview only. Re-run with --apply to create these bots.\n'
  exit 0
fi

mkdir -p -- "$root_real"
stage_root="$(mktemp -d "$root_real/.initialize-bots.XXXXXX")"
config_stage=""
cleanup() {
  [[ ! -d "$stage_root" ]] || rm -rf -- "$stage_root"
  [[ -z "$config_stage" || ! -e "$config_stage" ]] || rm -f -- "$config_stage"
}
trap cleanup EXIT

if ((add_to_fleet)); then
  config_stage="$(mktemp "$(dirname -- "$config_real")/.fleet.conf.initialize-bots.XXXXXX")"
  cp -p -- "$config_real" "$config_stage"
  {
    printf '\n# Added by initialize-bots.\nFLEET_BOT_NAMES+=(\n'
    for folder in "${folders[@]}"; do printf '  %q\n' "$folder"; done
    printf ')\n'
  } >> "$config_stage"
fi

for index in "${!symbols[@]}"; do
  staged_parent="$stage_root/${folders[$index]}"
  staged_checkout="$staged_parent/$FLEET_CHECKOUT_DIRNAME"
  mkdir -p -- "$staged_parent"
  clone_args=(clone --quiet)
  [[ -z "$branch" ]] || clone_args+=(--branch "$branch" --single-branch)
  clone_args+=(-- "$repo_url" "$staged_checkout")
  printf 'Cloning %s...\n' "${symbols[$index]}"
  git "${clone_args[@]}"

  helper_args=(
    "$SCRIPT_DIR/initialize-bot-env.py"
    --template "$template"
    --env-output "$staged_checkout/.env"
    --wallet-generator "$staged_checkout/generate_wallet.py"
    --wallet-output "$staged_checkout/wallet.txt"
    --symbol "${symbols[$index]}"
    --address "${addresses[$index]}"
  )
  for override in "${overrides[@]}"; do helper_args+=(--override "$override"); done
  ((show_private_keys == 0)) || helper_args+=(--reveal-private-key)
  wallet_result="$($python_bin "${helper_args[@]}")"
  if ((show_private_keys)); then
    IFS=$'\t' read -r public_address private_key <<< "$wallet_result"
    [[ -n "$public_address" && -n "$private_key" ]] || fleet_die "Wallet helper returned an incomplete result for ${symbols[$index]}"
    public_addresses+=("$public_address")
    private_keys+=("$private_key")
  else
    public_address="$wallet_result"
  fi

  if ((install_deps)); then
    printf 'Installing dependencies for %s...\n' "${symbols[$index]}"
    "$python_bin" -m venv "$staged_checkout/.venv"
    "$staged_checkout/.venv/bin/pip" install -r "$staged_checkout/requirements.txt"
  fi
  printf 'Prepared %s (wallet %s)\n' "${symbols[$index]}" "$public_address"
done

# Every expensive/fallible step completed in staging. Publish only new paths.
declare -a published=()
for index in "${!symbols[@]}"; do
  if mv -- "$stage_root/${folders[$index]}" "${final_parents[$index]}"; then
    published+=("$index")
    continue
  fi
  printf 'Error: Could not publish %s; rolling back this batch\n' "${symbols[$index]}" >&2
  for published_index in "${published[@]}"; do
    mv -- "${final_parents[$published_index]}" "$stage_root/${folders[$published_index]}" || \
      printf 'Error: Manual cleanup required: %s\n' "${final_parents[$published_index]}" >&2
  done
  exit 1
done

if ((add_to_fleet)); then
  if ! mv -- "$config_stage" "$config_real"; then
    printf 'Error: Could not update fleet config; rolling back this batch\n' >&2
    for published_index in "${published[@]}"; do
      mv -- "${final_parents[$published_index]}" "$stage_root/${folders[$published_index]}" || \
        printf 'Error: Manual cleanup required: %s\n' "${final_parents[$published_index]}" >&2
    done
    exit 1
  fi
  config_stage=""
fi

printf '\nCreated %d bot(s).\n' "${#symbols[@]}"
if ((add_to_fleet)); then
  printf 'Added %s to FLEET_BOT_NAMES in %s.\n' "${folders[*]}" "$config_real"
fi
if ((show_private_keys)); then
  printf '\nSENSITIVE — MetaMask private-key import list (protect terminal logs/scrollback):\n'
  for index in "${!symbols[@]}"; do
    printf '%s\t%s\t%s\n' "${symbols[$index]}" "${public_addresses[$index]}" "${private_keys[$index]}"
  done
  printf 'Each key also remains in its bot wallet.txt and protected .env (mode 0600).\n'
else
  printf 'Private keys were not printed. Use --show-private-keys only when terminal output is private.\n'
fi
if ((add_to_fleet)); then
  printf 'Complete blank token addresses and remaining .env settings, install dependencies if omitted, then run --check-config before starting them.\n'
else
  printf 'Complete blank token addresses and remaining .env settings, install dependencies if omitted, then run --check-config before adding names to FLEET_BOT_NAMES.\n'
fi
