#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
# shellcheck source=fleet-common.sh
source "$SCRIPT_DIR/fleet-common.sh"

usage() {
  printf 'Usage: backup-private-keys --output PATH [--config PATH]\n' >&2
}

config_path=""
output_path=""
while (($#)); do
  case "$1" in
    --config) (($# >= 2)) || fleet_die "--config requires a path"; config_path="$2"; shift 2 ;;
    --output) (($# >= 2)) || fleet_die "--output requires a path"; output_path="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) fleet_die "Unknown argument: $1" ;;
  esac
done
[[ -n "$output_path" ]] || { usage; fleet_die "--output is required"; }

fleet_load_config "$config_path"
fleet_apply_selection "" ""
fleet_validate_bots

helper_args=(--output "$output_path")
for bot_dir in "${FLEET_BOT_DIRS[@]}"; do
  env_file="$bot_dir/.env"
  [[ -f "$env_file" ]] || fleet_die "Missing .env: $env_file"
  helper_args+=(--entry "$(fleet_bot_name "$bot_dir")" "$env_file")
done

python3 "$SCRIPT_DIR/backup-private-keys.py" "${helper_args[@]}"
