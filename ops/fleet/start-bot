#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
source "$SCRIPT_DIR/fleet-common.sh"

usage() { cat <<'EOF'
Usage: start-bot NAME [--config PATH]

Start one intentionally stopped bot and durably mark it desired-running. If
the fleet session is absent, create it with only this bot running.
EOF
}

name=""; config_path=""
while (($#)); do
  case "$1" in
    --config) (($# >= 2)) || fleet_die "--config requires a path"; config_path="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    -*) fleet_die "Unknown option: $1" ;;
    *) [[ -z "$name" ]] || fleet_die "Provide exactly one bot name"; name="$1"; shift ;;
  esac
done
[[ -n "$name" ]] || fleet_die "A bot name is required"

fleet_load_config "$config_path"
fleet_apply_selection "$name" ""
fleet_validate_bots
fleet_require_tmux
bot_dir="${FLEET_BOT_DIRS[0]}"

if ! fleet_session_exists; then
  exec "$SCRIPT_DIR/start-fleet" --detach --only "$name" --config "$FLEET_CONFIG_PATH"
fi

pane_id="$(fleet_pane_for_bot_dir "$bot_dir" 2>/dev/null || true)"
if [[ -n "$pane_id" ]]; then
  tmux respawn-pane -k -t "$pane_id" -c "$bot_dir"
else
  pane_id="$(tmux split-window -d -P -F '#{pane_id}' -t "$FLEET_SESSION:$FLEET_WINDOW" -c "$bot_dir")"
fi
tmux select-pane -t "$pane_id" -T "$(fleet_bot_name "$bot_dir")"
fleet_send_command "$pane_id" "$(fleet_bot_command "$bot_dir")"
fleet_record_bot_running "$bot_dir"
fleet_record_running
tmux select-layout -t "$FLEET_SESSION:$FLEET_WINDOW" tiled >/dev/null
printf 'Started %s in pane %s; durable desired state is running.\n' "$(fleet_bot_name "$bot_dir")" "$pane_id"
