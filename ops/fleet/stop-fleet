#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
# shellcheck source=fleet-common.sh
source "$SCRIPT_DIR/fleet-common.sh"

usage() {
  cat <<'EOF'
Usage: stop-fleet [--if-running] [--config PATH]

Stop every bot by terminating the configured tmux session. --if-running makes
an already-stopped fleet a successful no-op (used by restart-fleet).
EOF
}

config_path=""
if_running=0
while (($#)); do
  case "$1" in
    --config)
      (($# >= 2)) || fleet_die "--config requires a path"
      config_path="$2"
      shift 2
      ;;
    --if-running) if_running=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) fleet_die "Unknown option: $1" ;;
  esac
done

fleet_load_config "$config_path"
fleet_require_tmux

if ! fleet_session_exists; then
  if ((if_running)); then
    printf 'Fleet is already stopped: %s\n' "$FLEET_SESSION"
    exit 0
  fi
  fleet_die "tmux session is not running: $FLEET_SESSION"
fi

tmux kill-session -t "=$FLEET_SESSION"
printf 'Stopped fleet tmux session: %s\n' "$FLEET_SESSION"
