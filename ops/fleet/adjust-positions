#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
# shellcheck source=fleet-common.sh
source "$SCRIPT_DIR/fleet-common.sh"

usage() {
  cat <<'EOF'
Usage:
  adjust-positions [--remove] [--apply] [--restart] [--config PATH] NAMES [COUNT]
  adjust-positions [--apply] [--restart] [--config PATH] NAME=DELTA [NAME=DELTA ...]
  adjust-positions --set-to-filled (--all | NAMES) [--apply] [--restart] [--config PATH]

Preview or change MAX_ACTIVE_POSITIONS relatively for one or more fleet bots.
NAMES is one name or a comma-separated list. COUNT defaults to 1. --remove
subtracts instead of adding. This changes capacity only; it never creates,
deletes, or rewrites filled position records.

--set-to-filled sets capacity equal to each selected bot's current filled
position count, preventing new entries without touching existing positions.
Use --all to select every bot in the configured fleet explicitly.

Assignment form applies an individual signed DELTA to each bot. Positive
values add capacity and negative values remove it.

Examples:
  adjust-positions earn
  adjust-positions earn,scopl 2
  adjust-positions --remove seedcoin 1
  adjust-positions earn=+2 scopl=-1 hookr=+3
  adjust-positions --apply earn=+2 scopl=-1 hookr=+3
  adjust-positions --apply earn,scopl 2
  adjust-positions --apply --restart earn
  adjust-positions --set-to-filled --all
  adjust-positions --set-to-filled --all --apply --restart
EOF
}

config_path=""
apply=0
restart=0
remove=0
set_to_filled=0
all_bots=0
positional=()
while (($#)); do
  case "$1" in
    --config) (($# >= 2)) || fleet_die "--config requires a path"; config_path="$2"; shift 2 ;;
    --apply) apply=1; shift ;;
    --restart) restart=1; shift ;;
    --remove) remove=1; shift ;;
    --set-to-filled) set_to_filled=1; shift ;;
    --all) all_bots=1; shift ;;
    -h|--help) usage; exit 0 ;;
    --*) fleet_die "Unknown option: $1" ;;
    *) positional+=("$1"); shift ;;
  esac
done

((restart == 0 || apply == 1)) || fleet_die "--restart requires --apply"
if ((set_to_filled)); then
  ((remove == 0)) || fleet_die "--set-to-filled cannot be combined with --remove"
  if ((all_bots)); then
    ((${#positional[@]} == 0)) || fleet_die "--all cannot be combined with bot names"
  else
    ((${#positional[@]} == 1)) || fleet_die "--set-to-filled requires --all or one NAMES list"
  fi
else
  ((all_bots == 0)) || fleet_die "--all requires --set-to-filled"
  ((${#positional[@]} >= 1)) || fleet_die "Provide NAMES and optional COUNT, or NAME=DELTA assignments"
fi

declare -A requested_deltas=()
assignment_mode=0
for item in "${positional[@]}"; do
  [[ "$item" != *=* ]] || assignment_mode=1
done

if ((set_to_filled)); then
  assignment_mode=0
  names="${positional[0]:-}"
elif ((assignment_mode)); then
  ((remove == 0)) || fleet_die "--remove cannot be combined with NAME=DELTA assignments; use a negative DELTA"
  names_list=()
  for assignment in "${positional[@]}"; do
    [[ "$assignment" == *=* ]] || fleet_die "Do not mix NAMES/COUNT syntax with NAME=DELTA assignments"
    name="${assignment%%=*}"
    delta="${assignment#*=}"
    [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || fleet_die "Invalid bot name: $name"
    [[ "$delta" =~ ^[+-]?[1-9][0-9]*$ ]] || fleet_die "DELTA for $name must be a nonzero signed integer"
    [[ -z "${requested_deltas[$name]+x}" ]] || fleet_die "Duplicate bot assignment: $name"
    requested_deltas["$name"]="$delta"
    names_list+=("$name")
  done
  names="$(IFS=,; printf '%s' "${names_list[*]}")"
else
  ((${#positional[@]} <= 2)) || fleet_die "Provide NAMES and optional COUNT"
  names="${positional[0]}"
  count="${positional[1]:-1}"
  [[ "$count" =~ ^[1-9][0-9]*$ ]] || fleet_die "COUNT must be a positive integer"
  delta="$count"
  ((remove == 0)) || delta="-$count"
fi

fleet_load_config "$config_path"
fleet_apply_selection "$names" ""
fleet_validate_bots
command -v python3 >/dev/null 2>&1 || fleet_die "python3 is required"

declare -A variables=() updated_values=()
printf 'Fleet position capacity: %s (%d selected)\n\n' \
  "$([[ $apply == 1 ]] && printf APPLY || printf PREVIEW)" "${#FLEET_BOT_DIRS[@]}"
for bot_dir in "${FLEET_BOT_DIRS[@]}"; do
  name="$(fleet_bot_name "$bot_dir")"
  if ((set_to_filled)); then
    capacity_args=(--set-to-filled)
  else
    bot_delta="${requested_deltas[$name]:-$delta}"
    capacity_args=(--delta "$bot_delta")
  fi
  if ! result="$(python3 "$SCRIPT_DIR/position-capacity.py" --bot-dir "$bot_dir" "${capacity_args[@]}")"; then
    fleet_die "Position-capacity validation failed for $name"
  fi
  IFS=$'\t' read -r variable current filled updated <<< "$result"
  variables["$bot_dir"]="$variable"
  updated_values["$bot_dir"]="$updated"
  if ((set_to_filled)); then
    printf '%-16s %-10s %s: %d -> %d (%d currently filled)\n' \
      "$name" "SET-FILLED" "$variable" "$current" "$updated" "$filled"
  else
    operation="ADD"
    ((bot_delta > 0)) || operation="REMOVE"
    magnitude="${bot_delta#-}"
    magnitude="${magnitude#+}"
    printf '%-16s %-6s %d  %s: %d -> %d (%d currently filled)\n' \
      "$name" "$operation" "$magnitude" "$variable" "$current" "$updated" "$filled"
  fi
done

if ((apply == 0)); then
  printf '\nPREVIEW ONLY: no files changed. Repeat with --apply after review.\n'
  exit 0
fi

timestamp="$(date -u +%Y%m%dT%H%M%SZ).$$"
backups=()
rollback() {
  local status=$?
  if ((status != 0)); then
    printf 'Update failed; restoring .env files from this run...\n' >&2
    for item in "${backups[@]}"; do
      env_file="${item%%|*}"
      backup="${item#*|}"
      cp -p -- "$backup" "$env_file" || true
    done
  fi
  exit "$status"
}
trap rollback EXIT

for bot_dir in "${FLEET_BOT_DIRS[@]}"; do
  env_file="$bot_dir/.env"
  backup="$env_file.bak.$timestamp"
  cp -p -- "$env_file" "$backup"
  backups+=("$env_file|$backup")
done
for bot_dir in "${FLEET_BOT_DIRS[@]}"; do
  python3 "$SCRIPT_DIR/update-env-file.py" --apply --file "$bot_dir/.env" \
    --allow-add "${variables[$bot_dir]}=${updated_values[$bot_dir]}"
done

trap - EXIT
printf '\nUpdated %d bot capacity setting(s). Backups end in .bak.%s.\n' "${#FLEET_BOT_DIRS[@]}" "$timestamp"
if ((restart)); then
  restart_args=()
  [[ -z "$config_path" ]] || restart_args+=(--config "$config_path")
  exec "$SCRIPT_DIR/restart-fleet" "${restart_args[@]}"
fi
printf 'Running bots retain their old capacity until restarted.\n'
