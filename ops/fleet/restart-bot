#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
# shellcheck source=fleet-common.sh
source "$SCRIPT_DIR/fleet-common.sh"

usage() {
  cat <<'EOF'
Usage: restart-bot NAME [--config PATH]

Cleanly restart one bot inside the running fleet tmux session. This kills the
pane's entire old process tree first, including suspended Ctrl+Z jobs, then
launches exactly one supervised bot process without disturbing other bots.
EOF
}

name=""; config_path=""
while (($#)); do
  case "$1" in
    --config) (($# >= 2)) || fleet_die "--config requires a path"; config_path="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    -*) fleet_die "Unknown option: $1" ;;
    *) [[ -z "$name" ]] || fleet_die "Provide exactly one bot name"; name="$1"; shift ;;
  esac
done
[[ -n "$name" ]] || fleet_die "A bot name is required"

fleet_load_config "$config_path"
fleet_apply_selection "$name" ""
((${#FLEET_BOT_DIRS[@]} == 1)) || fleet_die "Selection must resolve to one bot"
fleet_require_tmux
fleet_validate_bots
fleet_session_exists || fleet_die "tmux session is not running: $FLEET_SESSION"
bot_dir="${FLEET_BOT_DIRS[0]}"
pane_id="$(fleet_pane_for_bot_dir "$bot_dir")" || fleet_die "No fleet pane found for: $name"
tmux respawn-pane -k -t "$pane_id" -c "$bot_dir"
tmux select-pane -t "$pane_id" -T "$(fleet_bot_name "$bot_dir")"
fleet_send_command "$pane_id" "$(fleet_bot_command "$bot_dir")"
printf 'Restarted %s cleanly in pane %s.\n' "$(fleet_bot_name "$bot_dir")" "$pane_id"
