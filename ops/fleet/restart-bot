#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
# shellcheck source=fleet-common.sh
source "$SCRIPT_DIR/fleet-common.sh"

usage() {
  cat <<'EOF'
Usage: restart-bot NAME [NAME ...] [--config PATH]

Cleanly restart one or more bots inside the running fleet tmux session. Names
may be space- or comma-separated. Each target's entire old process tree is
killed first, including suspended Ctrl+Z jobs, then exactly one supervised bot
process is launched without disturbing unselected bots.
EOF
}

names=(); config_path=""
while (($#)); do
  case "$1" in
    --config) (($# >= 2)) || fleet_die "--config requires a path"; config_path="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    -*) fleet_die "Unknown option: $1" ;;
    *) names+=("$1"); shift ;;
  esac
done
(( ${#names[@]} > 0 )) || fleet_die "At least one bot name is required"
names_csv="$(IFS=,; printf '%s' "${names[*]}")"

fleet_load_config "$config_path"
fleet_apply_selection "$names_csv" ""
fleet_require_tmux
fleet_validate_bots
if ! fleet_session_exists; then
  exec "$SCRIPT_DIR/start-fleet" --detach --only "$names_csv" --config "$FLEET_CONFIG_PATH"
fi
for bot_dir in "${FLEET_BOT_DIRS[@]}"; do
  pane_id="$(fleet_pane_for_bot_dir "$bot_dir" 2>/dev/null || true)"
  if [[ -n "$pane_id" ]]; then
    tmux respawn-pane -k -t "$pane_id" -c "$bot_dir"
  else
    pane_id="$(tmux split-window -d -P -F '#{pane_id}' -t "$FLEET_SESSION:$FLEET_WINDOW" -c "$bot_dir")"
  fi
  tmux select-pane -t "$pane_id" -T "$(fleet_bot_name "$bot_dir")"
  fleet_send_command "$pane_id" "$(fleet_bot_command "$bot_dir")"
  fleet_record_bot_running "$bot_dir"
  printf 'Restarted %s cleanly in pane %s.\n' "$(fleet_bot_name "$bot_dir")" "$pane_id"
done
fleet_record_running
tmux select-layout -t "$FLEET_SESSION:$FLEET_WINDOW" tiled >/dev/null
printf 'Restarted %d bot(s).\n' "${#FLEET_BOT_DIRS[@]}"
