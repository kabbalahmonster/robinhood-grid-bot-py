#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
# shellcheck source=fleet-common.sh
source "$SCRIPT_DIR/fleet-common.sh"

usage() {
  cat <<'EOF'
Usage: stop-bot NAME [NAME ...] [--config PATH]

Durably stop one or more bots. Names may be space- or comma-separated. The
guardian and update commands preserve each bot's intent until start-bot or
restart-bot explicitly starts it again.
EOF
}

names=(); config_path=""
while (($#)); do
  case "$1" in
    --config) (($# >= 2)) || fleet_die "--config requires a path"; config_path="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    -*) fleet_die "Unknown option: $1" ;;
    *) names+=("$1"); shift ;;
  esac
done
(( ${#names[@]} > 0 )) || fleet_die "At least one bot name is required"
names_csv="$(IFS=,; printf '%s' "${names[*]}")"

fleet_load_config "$config_path"
fleet_apply_selection "$names_csv" ""
fleet_require_tmux
if ! fleet_session_exists; then
  for bot_dir in "${FLEET_BOT_DIRS[@]}"; do
    fleet_record_bot_stopped "$bot_dir"
    printf 'Recorded %s as intentionally stopped; fleet session is already absent.\n' "$(fleet_bot_name "$bot_dir")"
  done
  exit 0
fi
pane_ids=()
for bot_dir in "${FLEET_BOT_DIRS[@]}"; do
  pane_id="$(fleet_pane_for_bot_dir "$bot_dir")" || fleet_die "No fleet pane found for: $(fleet_bot_name "$bot_dir")"
  pane_ids+=("$pane_id")
done
for index in "${!FLEET_BOT_DIRS[@]}"; do
  bot_dir="${FLEET_BOT_DIRS[$index]}"
  pane_id="${pane_ids[$index]}"
  fleet_record_bot_stopped "$bot_dir"
  tmux respawn-pane -k -t "$pane_id" -c "$bot_dir"
  tmux select-pane -t "$pane_id" -T "$(fleet_bot_name "$bot_dir")"
  printf 'Stopped %s in pane %s; durable desired state is stopped.\n' "$(fleet_bot_name "$bot_dir")" "$pane_id"
done
printf 'Stopped %d bot(s).\n' "${#FLEET_BOT_DIRS[@]}"
