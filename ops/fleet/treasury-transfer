#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
# shellcheck source=fleet-common.sh
source "$SCRIPT_DIR/fleet-common.sh"

usage() {
  cat <<'EOF'
Usage: treasury-transfer --asset ASSET --amount AMOUNT --recipient ADDRESS [options]

Plan or execute the same guarded treasury transfer from every configured bot.
Dry run is the default.

Required:
  --asset ETH|USDG|ADDRESS     Native ETH, configured USDG, or an ERC-20 contract
  --amount DECIMAL|all        Exact amount; "all" is allowed only for ERC-20s
  --recipient ADDRESS         Treasury receiving each transfer

Guards:
  --confirm-recipient ADDRESS Exact repeat for a non-allowlisted recipient
  --execute                   Broadcast after reviewing the complete dry run
  --confirm-fleet-stopped     Required with --execute
  --config PATH               Use an alternate fleet configuration
  -h, --help                  Show this help

Execution is refused while the configured tmux fleet session exists. Native
ETH transfers additionally retain each bot's configured ETH_GAS_RESERVE after
the amount and estimated maximum transaction fee.
EOF
}

config_path=""
asset=""
amount=""
recipient=""
confirmed_recipient=""
execute=0
fleet_stopped=0

while (($#)); do
  case "$1" in
    --config) (($# >= 2)) || fleet_die "--config requires a path"; config_path="$2"; shift 2 ;;
    --asset) (($# >= 2)) || fleet_die "--asset requires a value"; asset="$2"; shift 2 ;;
    --amount) (($# >= 2)) || fleet_die "--amount requires a value"; amount="$2"; shift 2 ;;
    --recipient) (($# >= 2)) || fleet_die "--recipient requires an address"; recipient="$2"; shift 2 ;;
    --confirm-recipient) (($# >= 2)) || fleet_die "--confirm-recipient requires an address"; confirmed_recipient="$2"; shift 2 ;;
    --execute) execute=1; shift ;;
    --confirm-fleet-stopped) fleet_stopped=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) fleet_die "Unknown option: $1" ;;
  esac
done

[[ "$recipient" =~ ^0x[0-9a-fA-F]{40}$ ]] || fleet_die "--recipient must be a 20-byte 0x-prefixed EVM address"
[[ -n "$asset" ]] || fleet_die "--asset is required"
[[ "$amount" == "all" || "$amount" =~ ^[0-9]+([.][0-9]+)?$ ]] || fleet_die "--amount must be a positive decimal or 'all'"
[[ "$amount" != "0" && "$amount" != "0.0" ]] || fleet_die "--amount must be positive"
if [[ -n "$confirmed_recipient" && "$confirmed_recipient" != "$recipient" ]]; then
  fleet_die "--confirm-recipient must exactly match --recipient"
fi
if ((execute && !fleet_stopped)); then
  fleet_die "--execute requires --confirm-fleet-stopped"
fi

asset_upper="${asset^^}"
case "$asset_upper" in
  ETH)
    [[ "$amount" != "all" ]] || fleet_die "Native ETH requires an exact --amount; 'all' is intentionally forbidden"
    ;;
  USDG) ;;
  *)
    [[ "$asset" =~ ^0x[0-9a-fA-F]{40}$ ]] || fleet_die "--asset must be ETH, USDG, or an ERC-20 contract address"
    ;;
esac

fleet_load_config "$config_path"
fleet_validate_bots
if ((execute)); then
  fleet_require_tmux
  if fleet_session_exists; then
    fleet_die "Refusing to broadcast while tmux session '$FLEET_SESSION' is running. Stop the fleet first."
  fi
fi

mode="DRY RUN"
((execute == 0)) || mode="EXECUTE"
printf 'Fleet treasury transfer: %s\nAsset: %s\nAmount per wallet: %s\nRecipient: %s\nBots configured: %d\n\n' \
  "$mode" "$asset" "$amount" "$recipient" "${#FLEET_BOT_DIRS[@]}"

successes=0
failures=0
for bot_dir in "${FLEET_BOT_DIRS[@]}"; do
  python_bin="$(fleet_python_for "$bot_dir")"
  printf '%s\n%s\n' '------------------------------------------------------------' "$bot_dir"

  if [[ "$asset_upper" == "ETH" ]]; then
    command_args=("$python_bin" "$FLEET_ENTRYPOINT" --transfer-eth --recipient "$recipient" --amount "$amount")
  elif [[ "$asset_upper" == "USDG" ]]; then
    command_args=("$python_bin" "$FLEET_ENTRYPOINT" --sweep-usdg "$recipient" --amount "$amount")
  else
    command_args=("$python_bin" "$FLEET_ENTRYPOINT" --transfer-token "$asset" --recipient "$recipient" --amount "$amount")
  fi
  [[ -z "$confirmed_recipient" ]] || command_args+=(--confirm-recipient "$confirmed_recipient")
  ((execute == 0)) || command_args+=(--execute --confirm-bot-stopped)

  if (cd "$bot_dir" && "${command_args[@]}"); then
    successes=$((successes + 1))
  else
    printf 'FAILED: %s\n' "$bot_dir" >&2
    failures=$((failures + 1))
  fi
done

printf '\nFleet treasury transfer complete: %d succeeded, %d failed (%s).\n' \
  "$successes" "$failures" "$mode"
((failures == 0))
