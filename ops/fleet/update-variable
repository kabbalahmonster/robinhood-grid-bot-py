#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
# shellcheck source=fleet-common.sh
source "$SCRIPT_DIR/fleet-common.sh"

usage() {
  cat <<'EOF'
Usage: update-variable [--apply] [--restart] [--allow-add] [--skip-errors] [--only NAMES] [--exclude NAMES] [--config PATH] NAME=VALUE [NAME=VALUE ...]

Preview or atomically update one or more variables in every configured bot's
.env file. Preview is the default. Existing .env files are required, variables
must already exist unless --allow-add is supplied, and --restart is available
only with --apply. --skip-errors reports and excludes invalid targets while
continuing with the rest of the fleet.

Examples:
  update-variable ETH_GAS_RESERVE=0.0005
  update-variable --apply --restart ETH_GAS_RESERVE=0.0005
EOF
}

config_path=""
apply=0
restart=0
allow_add=0
skip_errors=0
assignments=()
only=""
exclude=""
while (($#)); do
  case "$1" in
    --config) (($# >= 2)) || fleet_die "--config requires a path"; config_path="$2"; shift 2 ;;
    --apply) apply=1; shift ;;
    --restart) restart=1; shift ;;
    --allow-add) allow_add=1; shift ;;
    --skip-errors) skip_errors=1; shift ;;
    --only) (($# >= 2)) || fleet_die "--only requires comma-separated names"; only="$2"; shift 2 ;;
    --exclude) (($# >= 2)) || fleet_die "--exclude requires comma-separated names"; exclude="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    --*) fleet_die "Unknown option: $1" ;;
    *) assignments+=("$1"); shift ;;
  esac
done

((${#assignments[@]} > 0)) || fleet_die "At least one NAME=VALUE assignment is required"
((restart == 0 || apply == 1)) || fleet_die "--restart requires --apply"
[[ -z "$only$exclude" || $restart == 0 ]] || fleet_die "--restart cannot be combined with --only/--exclude; restart deliberately afterward"
fleet_load_config "$config_path"
fleet_apply_selection "$only" "$exclude"
fleet_validate_bots
command -v python3 >/dev/null 2>&1 || fleet_die "python3 is required to update dotenv files safely"

helper_args=()
((allow_add == 0)) || helper_args+=(--allow-add)

printf 'Fleet variable update: %s\nBots configured: %d\n\n' "$([[ $apply == 1 ]] && echo APPLY || echo PREVIEW)" "${#FLEET_BOT_DIRS[@]}"
valid_bot_dirs=()
skipped_bot_names=()
for bot_dir in "${FLEET_BOT_DIRS[@]}"; do
  env_file="$bot_dir/.env"
  validation_error=""
  [[ -f "$env_file" ]] || validation_error="Missing .env: $env_file"
  [[ -n "$validation_error" || -w "$env_file" ]] || validation_error="Not writable: $env_file"
  if [[ -n "$validation_error" ]]; then
    if ((skip_errors == 0)); then fleet_die "$validation_error"; fi
    printf 'SKIPPED %s: %s\n' "$(fleet_bot_name "$bot_dir")" "$validation_error" >&2
    skipped_bot_names+=("$(fleet_bot_name "$bot_dir")")
    continue
  fi
  if python3 "$SCRIPT_DIR/update-env-file.py" --file "$env_file" "${helper_args[@]}" "${assignments[@]}"; then
    valid_bot_dirs+=("$bot_dir")
  else
    if ((skip_errors == 0)); then exit 1; fi
    printf 'SKIPPED %s: dotenv validation failed\n' "$(fleet_bot_name "$bot_dir")" >&2
    skipped_bot_names+=("$(fleet_bot_name "$bot_dir")")
  fi
done

((${#valid_bot_dirs[@]} > 0)) || fleet_die "No valid bot .env files remain after validation"
FLEET_BOT_DIRS=("${valid_bot_dirs[@]}")
if ((${#skipped_bot_names[@]} > 0)); then
  printf '\nSkipped %d invalid target(s): %s\n' "${#skipped_bot_names[@]}" "${skipped_bot_names[*]}"
fi

if ((apply == 0)); then
  printf '\nPREVIEW ONLY: no files changed. Repeat with --apply after review.\n'
  exit 0
fi

timestamp="$(date -u +%Y%m%dT%H%M%SZ).$$"
backups=()
rollback() {
  local status=$?
  if ((status != 0)); then
    printf 'Update failed; restoring .env files from this run...\n' >&2
    for item in "${backups[@]}"; do
      env_file="${item%%|*}"
      backup="${item#*|}"
      cp -p -- "$backup" "$env_file" || true
    done
  fi
  exit "$status"
}
trap rollback EXIT

for bot_dir in "${FLEET_BOT_DIRS[@]}"; do
  env_file="$bot_dir/.env"
  backup="$env_file.bak.$timestamp"
  cp -p -- "$env_file" "$backup"
  backups+=("$env_file|$backup")
done
for bot_dir in "${FLEET_BOT_DIRS[@]}"; do
  env_file="$bot_dir/.env"
  python3 "$SCRIPT_DIR/update-env-file.py" --apply --file "$env_file" "${helper_args[@]}" "${assignments[@]}"
done

trap - EXIT
printf '\nUpdated %d .env files. Backups end in .bak.%s.\n' "${#FLEET_BOT_DIRS[@]}" "$timestamp"
if ((restart)); then
  restart_args=()
  [[ -z "$config_path" ]] || restart_args+=(--config "$config_path")
  exec "$SCRIPT_DIR/restart-fleet" "${restart_args[@]}"
fi
printf 'Running bots retain their old environment until restarted.\n'
