#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
# shellcheck source=fleet-common.sh
source "$SCRIPT_DIR/fleet-common.sh"

usage() {
  cat <<'EOF'
Usage: start-fleet [--detach] [--only NAMES] [--exclude NAMES] [--config PATH]

Create the configured tmux session and start every bot in its own tiled pane.
By default, attach to the session after startup. --detach leaves it running in
the background.
EOF
}

config_path=""
detach=0
only=""
exclude=""
while (($#)); do
  case "$1" in
    --config)
      (($# >= 2)) || fleet_die "--config requires a path"
      config_path="$2"
      shift 2
      ;;
    --detach) detach=1; shift ;;
    --only) (($# >= 2)) || fleet_die "--only requires comma-separated names"; only="$2"; shift 2 ;;
    --exclude) (($# >= 2)) || fleet_die "--exclude requires comma-separated names"; exclude="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) fleet_die "Unknown option: $1" ;;
  esac
done

fleet_load_config "$config_path"
fleet_require_tmux

if fleet_session_exists; then
  fleet_record_running
  fleet_die "tmux session already exists: $FLEET_SESSION
Attach with: tmux attach-session -t '$FLEET_SESSION'"
fi

# Startup is a transaction: suppress guardian resurrection until every pane is
# created, then commit running intent only after the complete session exists.
fleet_record_stopped
fleet_apply_selection "$only" "$exclude"
fleet_validate_bots
fleet_sort_targets_by_name

created=0
cleanup_partial_session() {
  local status=$?
  if ((status != 0 && created)); then
    tmux kill-session -t "=$FLEET_SESSION" 2>/dev/null || true
    printf 'Removed partially created tmux session: %s\n' "$FLEET_SESSION" >&2
  fi
  exit "$status"
}
trap cleanup_partial_session EXIT

first_dir="${FLEET_BOT_DIRS[0]}"
: "${FLEET_TMUX_WIDTH:=240}"
: "${FLEET_TMUX_HEIGHT:=80}"
[[ "$FLEET_TMUX_WIDTH" =~ ^[1-9][0-9]*$ ]] || fleet_die "FLEET_TMUX_WIDTH must be a positive integer"
[[ "$FLEET_TMUX_HEIGHT" =~ ^[1-9][0-9]*$ ]] || fleet_die "FLEET_TMUX_HEIGHT must be a positive integer"
# Headless launches inherit tmux's small default geometry. A large fleet can
# otherwise fail partway through with "no space for new pane" under systemd.
tmux new-session -d -x "$FLEET_TMUX_WIDTH" -y "$FLEET_TMUX_HEIGHT" \
  -s "$FLEET_SESSION" -n "$FLEET_WINDOW" -c "$first_dir"
created=1
first_pane="$(tmux display-message -p -t "=$FLEET_SESSION" '#{pane_id}')"
tmux select-pane -t "$first_pane" -T "$(basename -- "$(dirname -- "$first_dir")")"
fleet_send_command "$first_pane" "$(fleet_bot_command "$first_dir")"

# tmux inserts each detached split immediately after the window's still-active
# first pane. Creating the remaining panes in ascending order therefore renders
# them in reverse order (first, Z..B). Feed tmux the remainder in reverse so
# the visible tiled traversal is the intended alphabetical A..Z order.
for ((index=${#FLEET_BOT_DIRS[@]} - 1; index >= 1; index--)); do
  bot_dir="${FLEET_BOT_DIRS[index]}"
  if [[ "$FLEET_START_STAGGER" != "0" ]]; then
    sleep "$FLEET_START_STAGGER"
  fi
  pane_id="$(tmux split-window -d -P -F '#{pane_id}' -t "$FLEET_SESSION:$FLEET_WINDOW" -c "$bot_dir")"
  tmux select-pane -t "$pane_id" -T "$(basename -- "$(dirname -- "$bot_dir")")"
  fleet_send_command "$pane_id" "$(fleet_bot_command "$bot_dir")"
  tmux select-layout -t "$FLEET_SESSION:$FLEET_WINDOW" tiled >/dev/null
done

tmux select-layout -t "$FLEET_SESSION:$FLEET_WINDOW" tiled >/dev/null
trap - EXIT
# Running intent is committed only after the complete session exists. A failed
# validation or partial launch therefore preserves an earlier stopped intent.
fleet_record_running
printf 'Started %d bots in tmux session %s.\n' "${#FLEET_BOT_DIRS[@]}" "$FLEET_SESSION"

if ((detach)); then
  printf 'Attach with: tmux attach-session -t %q\n' "$FLEET_SESSION"
else
  exec tmux attach-session -t "=$FLEET_SESSION"
fi
