#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
# shellcheck source=fleet-common.sh
source "$SCRIPT_DIR/fleet-common.sh"

usage() {
  cat <<'EOF'
Usage: pass-positions --from SPECS --to SPECS [--positions N] [options]
       pass-positions --resume PLAN_ID --execute --confirm-plan PLAN_ID

Reallocate whole unused position-capacity slots and their native ETH reserve
between fleet bots. Dry run is the default and prints a live approval plan;
no funds or files change unless --execute is supplied.

Allocation:
  --from SPECS               Donors: BOT or BOT=COUNT, comma-separated/repeatable
  --to SPECS                 Recipients: same syntax as --from
  --positions N              Total whole positions to move
  --amount-per-position ETH  Override every donor's reserve amount
  --amount-from BOT=ETH      Override one donor's amount (repeatable)

Plain BOT entries share unassigned positions as evenly as possible, in supplied
order. BOT=COUNT is exact. --positions may be omitted when every bot on either
side has an exact count; if both sides are exact, their totals must match.

Execution:
  --execute                  Broadcast ETH and commit capacity changes
  --confirm-plan PLAN_ID     Exact plan ID printed by the dry run
  --manage-bots              Stop/restart only involved desired-running bots
  --auto-stop-restart        Alias for --manage-bots
  --confirm-fleet-stopped    Alternative for an already-stopped whole fleet
  --resume PLAN_ID           Safely resume an interrupted journal
  --config PATH              Alternate fleet configuration
  -h, --help                 Show this help

Examples:
  # Preview 2 positions from PRISM to URMOM.
  pass-positions --from prism --to urmom --positions 2

  # Execute the reviewed plan while unrelated bots keep running.
  pass-positions --from prism --to urmom --positions 2 \
    --execute --manage-bots --confirm-plan PLAN_ID

  # Fairly split 3 whole positions across multiple donors and recipients.
  pass-positions --from sarn,prism --to urmom,delta --positions 3

  # Exact counts mixed with fair remainder allocation.
  pass-positions --from prism=2,sarn,delta --to urmom=1,earn,hookr \
    --positions 5

  # Use one amount globally, or donor-specific amounts.
  pass-positions --from prism,sarn --to urmom --positions 3 \
    --amount-per-position 0.0015
  pass-positions --from prism,sarn --to urmom --positions 3 \
    --amount-from prism=0.002 --amount-from sarn=0.0015

  # Resume without repeating confirmed transfers.
  pass-positions --resume PLAN_ID --execute --manage-bots \
    --confirm-plan PLAN_ID

Safety model:
  * Default amount is each donor's TREASURY_POSITION_RESERVE_ETH.
  * Donor capacity never drops below filled positions.
  * Recipient reserve floors, balances, chain, wallets, and gas are preflighted.
  * The complete plan is validated before the first broadcast.
  * Broadcast hashes are journaled immediately; ambiguous hashes are not resent.
  * Capacity files commit only after every transfer confirms and keep backups.
  * Managed mode restarts involved bots only after complete success; failures
    leave them intentionally stopped for safe diagnosis or --resume.
EOF
}

config_path=""; execute=0; fleet_stopped=0; manage_bots=0; forwarded=()
while (($#)); do
  case "$1" in
    --config) (($# >= 2)) || fleet_die "--config requires a path"; config_path="$2"; shift 2 ;;
    --execute) execute=1; forwarded+=("$1"); shift ;;
    --confirm-fleet-stopped) fleet_stopped=1; shift ;;
    --manage-bots|--auto-stop-restart) manage_bots=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) forwarded+=("$1"); shift ;;
  esac
done
((manage_bots == 0 || execute == 1)) || fleet_die "--manage-bots requires --execute"
((manage_bots == 0 || fleet_stopped == 0)) || fleet_die "Use --manage-bots or --confirm-fleet-stopped, not both"
((execute == 0 || fleet_stopped == 1 || manage_bots == 1)) || \
  fleet_die "--execute requires --confirm-fleet-stopped or --manage-bots"

fleet_load_config "$config_path"
fleet_validate_bots
printf 'Preparing position-pass %s; validating allocation and live chain state...\n' \
  "$([[ $execute == 1 ]] && printf execution || printf dry-run)"
if ((execute)); then
  fleet_require_tmux
  if ((manage_bots == 0)); then
    fleet_session_exists && fleet_die "Refusing to pass positions while tmux session '$FLEET_SESSION' is running. Stop the fleet first."
  fi
fi

python_bin="$(fleet_python_for "${FLEET_BOT_DIRS[0]}")" || fleet_die "No Python interpreter found"
state_root="$(dirname -- "$(fleet_desired_state_file)")/position-passes"
args=("$python_bin" "$SCRIPT_DIR/pass-positions.py" --journal-dir "$state_root")
for bot_dir in "${FLEET_BOT_DIRS[@]}"; do
  args+=(--bot "$(fleet_bot_name "$bot_dir")=$bot_dir")
done
args+=("${forwarded[@]}")
if ((manage_bots == 0)); then
  exec "${args[@]}"
fi

mapfile -t involved_names < <("${args[@]}" --list-involved)
((${#involved_names[@]} > 0)) || fleet_die "Position plan resolved to no involved bots"
declare -A configured_dirs=()
for bot_dir in "${FLEET_BOT_DIRS[@]}"; do
  configured_dirs["$(fleet_bot_name "$bot_dir" | tr '[:upper:]' '[:lower:]')"]="$bot_dir"
done
restart_names=()
pane_names=()
if fleet_session_exists; then
  for name in "${involved_names[@]}"; do
    normalized="$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')"
    bot_dir="${configured_dirs[$normalized]:-}"
    [[ -n "$bot_dir" ]] || fleet_die "Involved bot is no longer configured: $name"
    if fleet_bot_should_run "$bot_dir"; then
      restart_names+=("$name")
      if fleet_pane_for_bot_dir "$bot_dir" >/dev/null 2>&1; then
        pane_names+=("$name")
      else
        # Preserve desired-running intent across a missing/crashed pane, but
        # suppress the guardian until the position pass finishes.
        fleet_record_bot_stopped "$bot_dir"
      fi
    fi
  done
elif fleet_should_run; then
  fleet_die "Fleet session '$FLEET_SESSION' is absent but desired-running; refusing managed execution because the guardian could restart bots mid-transfer"
fi

if ((${#pane_names[@]} > 0)); then
  "$SCRIPT_DIR/stop-bot" "${pane_names[@]}" --config "$FLEET_CONFIG_PATH"
fi
if ((${#restart_names[@]} > 0)); then
  printf 'Automatically stopped %d involved desired-running bot(s).\n' "${#restart_names[@]}"
else
  printf 'No involved bots were running; existing stopped state will be preserved.\n'
fi

if "${args[@]}"; then
  :
else
  status=$?
  printf 'Position pass did not complete; involved bots remain intentionally stopped for safe resume.\n' >&2
  exit "$status"
fi

if ((${#restart_names[@]} > 0)); then
  if ! "$SCRIPT_DIR/restart-bot" "${restart_names[@]}" --config "$FLEET_CONFIG_PATH"; then
    printf 'Position pass completed, but automatic restart failed. Restart these bots manually: %s\n' \
      "${restart_names[*]}" >&2
    exit 1
  fi
  printf 'Automatically restarted %d bot(s) that were desired-running before the pass.\n' "${#restart_names[@]}"
fi
