#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
# shellcheck source=fleet-common.sh
source "$SCRIPT_DIR/fleet-common.sh"

usage() {
  cat <<'EOF'
Usage: fleet-watch [--once] [--interval SECONDS] [--only NAMES] [--exclude NAMES] [--config PATH]

Show one live, phone-friendly row per bot. Problems sort to the top. This reads
local status snapshots written by running bots and performs no RPC/API calls.
EOF
}

config_path=""; only=""; exclude=""; watch_args=()
while (($#)); do
  case "$1" in
    --config) (($# >= 2)) || fleet_die "--config requires a path"; config_path="$2"; shift 2 ;;
    --only) (($# >= 2)) || fleet_die "--only requires comma-separated names"; only="$2"; shift 2 ;;
    --exclude) (($# >= 2)) || fleet_die "--exclude requires comma-separated names"; exclude="$2"; shift 2 ;;
    --interval) (($# >= 2)) || fleet_die "--interval requires seconds"; watch_args+=("$1" "$2"); shift 2 ;;
    --once|--no-color) watch_args+=("$1"); shift ;;
    -h|--help) usage; exit 0 ;;
    *) fleet_die "Unknown option: $1" ;;
  esac
done

fleet_load_config "$config_path"
fleet_apply_selection "$only" "$exclude"
fleet_validate_bots >&2
exec python3 "$SCRIPT_DIR/fleet-watch.py" "${watch_args[@]}" "${FLEET_BOT_DIRS[@]}"
