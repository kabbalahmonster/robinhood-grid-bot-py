#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
source "$SCRIPT_DIR/fleet-common.sh"

usage() { cat <<'EOF'
Usage: template-from-bot NAME [--template PATH] [--apply --confirm-template-update] [--config PATH]

Preview or replace the initialize-bots dotenv template using one fleet bot's
.env. The generated template omits PRIVATE_KEY, TOKEN_SYMBOL, and TOKEN_ADDRESS.
The configured FLEET_ENV_TEMPLATE is the default destination; --template
overrides it for this command. The source bot and fleet config are never changed.
EOF
}

name=""; template=""; config_path=""; apply=0; confirm=0
while (($#)); do
  case "$1" in
    --template) (($# >= 2)) || fleet_die "--template requires a path"; template="$2"; shift 2 ;;
    --config) (($# >= 2)) || fleet_die "--config requires a path"; config_path="$2"; shift 2 ;;
    --apply) apply=1; shift ;;
    --confirm-template-update) confirm=1; shift ;;
    -h|--help) usage; exit 0 ;;
    -*) fleet_die "Unknown option: $1" ;;
    *) [[ -z "$name" ]] || fleet_die "Provide exactly one bot name"; name="$1"; shift ;;
  esac
done
[[ -n "$name" ]] || fleet_die "A bot name is required"
(( apply == 0 || confirm == 1 )) || fleet_die "--apply requires --confirm-template-update"

fleet_load_config "$config_path"
fleet_apply_selection "$name" ""
fleet_validate_bots
: "${FLEET_ENV_TEMPLATE:=}"
template="${template:-$FLEET_ENV_TEMPLATE}"
[[ -n "$template" ]] || fleet_die "No env template configured; pass --template PATH or set FLEET_ENV_TEMPLATE in fleet.conf"
template="$(readlink -m -- "$template")"
source_env="${FLEET_BOT_DIRS[0]}/.env"
args=(--source "$source_env" --destination "$template")
(( apply == 0)) || args+=(--apply)
python3 "$SCRIPT_DIR/template-from-bot.py" "${args[@]}"
