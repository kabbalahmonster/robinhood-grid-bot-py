#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
# shellcheck source=fleet-common.sh
source "$SCRIPT_DIR/fleet-common.sh"

usage() {
  cat <<'EOF'
Usage: reconcile-position-balances [--only NAMES] [--exclude NAMES] [--apply]
                                   [--confirm-bot-stopped] [--config PATH]

Compare total tracked managed-token balances with each wallet. When tracked
balances exceed wallet reality, preview a proportional haircut across active
positions. Applying preserves cost basis, creates timestamped backups, and
writes data/position_balance_reconciliations.json. It never invents tokens or
absorbs untracked wallet surplus.
EOF
}

config_path=""; only=""; exclude=""; apply=0; confirmed=0
while (($#)); do
  case "$1" in
    --config) (($# >= 2)) || fleet_die "--config requires a path"; config_path="$2"; shift 2 ;;
    --only) (($# >= 2)) || fleet_die "--only requires names"; only="$2"; shift 2 ;;
    --exclude) (($# >= 2)) || fleet_die "--exclude requires names"; exclude="$2"; shift 2 ;;
    --apply) apply=1; shift ;;
    --confirm-bot-stopped) confirmed=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) fleet_die "Unknown argument: $1" ;;
  esac
done
((apply == 0 || confirmed == 1)) || fleet_die "--apply requires --confirm-bot-stopped"

fleet_load_config "$config_path"
fleet_apply_selection "$only" "$exclude"
fleet_validate_bots
printf 'Position reconciliation: %s\n\n' "$([[ $apply == 1 ]] && printf APPLY || printf PREVIEW)"
for bot_dir in "${FLEET_BOT_DIRS[@]}"; do
  name="$(fleet_bot_name "$bot_dir")"
  python_bin="$(fleet_python_for "$bot_dir")"
  args=()
  ((apply == 0)) || args+=(--apply)
  output="$(cd "$bot_dir" && "$python_bin" "$SCRIPT_DIR/reconcile-position-balances.py" "${args[@]}")" || fleet_die "Reconciliation failed for $name"
  python3 - "$name" "$output" <<'PY'
import json, sys
name, raw = sys.argv[1:]
data = json.loads(raw)
print(f"{name}: wallet={data['wallet_raw']} tracked={data['tracked_raw']} deficit={data['deficit_raw']} raw")
for change in data["changes"]:
    print(f"  {change['file']} #{change['position_id']}: {change['old_balance_raw']} -> {change['new_balance_raw']} (haircut {change['haircut_raw']})")
PY
done
if ((apply == 0)); then
  printf '\nPREVIEW ONLY: stop the selected bot(s), then repeat with --apply --confirm-bot-stopped.\n'
else
  printf '\nReconciliation applied with backups and audit records. Restart bots after review.\n'
fi
